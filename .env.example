# Gemini 3.0 Pro Image (나노바나나 Pro) API 키 — 이미지 생성용
# https://aistudio.google.com/apikey 에서 발급
# 이미지 모델은 무료 등급에서 호출할 수 없음 — 결제 계정이 연결된 프로젝트(Tier 1 이상)의 키 필요
# HTML 엔진만 쓸 때는 이 파일 자체가 필요 없음
GEMINI_API_KEY=your_gemini_api_key_here

# (옵션) 품질 체크 서브에이전트 호출용 Anthropic API
# 생략 시 로컬 룰 기반 체크만 수행
ANTHROPIC_API_KEY=

# (옵션) typo-check.py 한글 전사용 Gemini 모델. 비우면 gemini-2.5-flash
GEMINI_OCR_MODEL=
